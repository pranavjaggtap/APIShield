# Copy this file to .env and fill in real values for local development.
# .env is git-ignored and must never be committed.

# PostgreSQL connection (Phase 2A infrastructure)
# DB_HOST/DB_PORT default to localhost:5432 for IntelliJ/Maven local dev.
# Docker Compose overrides these internally to the "postgres" service name -
# do not set DB_HOST=postgres here, this file is for local dev only.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apishield_db
DB_USERNAME=apishield_user
DB_PASSWORD=

# Redis connection (Phase 2B infrastructure)
# Same rule as above: this file's REDIS_HOST is for local dev only.
# Docker Compose overrides it internally to the "redis" service name.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# User Service target (Phase 2C infrastructure)
# Docker Compose overrides this internally to the "user-service" service name.
USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=8081
